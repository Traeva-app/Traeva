{
  "manifest_version": 3,
  "name": "Traeva Source",
  "version": "0.1.0",
  "description": "Save Chrome download sources to your paired, local Traeva instance.",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Traeva Source settings" },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"
  }
}
