    "allow-preview-undo",
    "allow-reconcile-action",
    "allow-get-memory-consent",
    "allow-set-memory-consent",
    "allow-get-memory-changes",
    "allow-get-change-lines",
    "allow-start-memory-search",
    "allow-get-memory-search",
    "allow-answer-memory-search",
    "allow-retry-memory-search",
