{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traeva",
  "version": "0.1.0",
  "identifier": "io.github.p30g53.traeva",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Traeva",
        "width": 1120,
        "height": 760
      },
      {
        "label": "pet",
        "title": "Traeva pet",
        "width": 96,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      },
      {
        "label": "quick",
        "transparent": true,
        "shadow": true,
        "title": "Traeva search",
        "width": 560,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "acceptFirstMouse": true
      },
      {
        "label": "ask",
        "transparent": true,
        "shadow": true,
        "title": "Traeva",
        "width": 440,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main-window",
        "pet-window",
        "quick-window",
        "ask-window"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "markdown",
          "pdf",
          "jpg",
          "jpeg",
          "png",
          "docx",
          "pptx",
          "xlsx"
        ],
        "contentTypes": [
          "public.data"
        ],
        "name": "Document",
        "role": "Viewer",
        "rank": "None"
      }
    ]
  }
}
